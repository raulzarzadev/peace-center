---
import {
	getLangFromUrl,
	useTranslations,
	TRANSPORT_DATA,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { aguila, tiburonUrbano, ventanaBus } = TRANSPORT_DATA;
---

<section id="transporte" class="py-20 bg-stone-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-stone-800 sm:text-4xl font-handwritten transform -rotate-1">{t('transport.title')}</h2>
      <p class="mt-4 text-lg text-stone-500">{t('transport.subtitle')}</p>
    </div>

    <div class="space-y-4">

      <!-- Autobuses Águila -->
      <details class="transport-accordion group bg-white rounded-2xl shadow-lg border border-stone-200 overflow-hidden">
        <summary class="cursor-pointer select-none list-none">
          <div class="bg-teal-700 px-5 py-4 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <div class="shrink-0 w-10 h-10 bg-teal-600 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8m-8 4h8m-4 4v3m-6 0h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v10a2 2 0 002 2zm-2 0h16v2a1 1 0 01-1 1H5a1 1 0 01-1-1v-2z"/></svg>
              </div>
              <div class="min-w-0">
                <h3 class="text-lg font-bold text-white font-handwritten leading-tight">{aguila.name}</h3>
                <p class="text-teal-200 text-xs mt-0.5 truncate">{t('transport.intercity')} · 8 {lang === 'es' ? 'rutas' : 'routes'}</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-teal-200 transition-transform duration-300 group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </div>
        </summary>
        <div class="p-5">
          <p class="text-xs text-stone-500 mb-4">{aguila.terminal[lang]}</p>

          <!-- Desktop table -->
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b-2 border-stone-200">
                  <th class="text-left py-2 pr-4 text-stone-600 font-semibold">{lang === 'es' ? 'Destino' : 'Destination'}</th>
                  <th class="text-left py-2 pr-4 text-stone-600 font-semibold">{t('transport.schedule')}</th>
                  <th class="text-right py-2 text-stone-600 font-semibold">{t('transport.fare')}</th>
                </tr>
              </thead>
              <tbody>
                {aguila.routes.map((route) => (
                  <tr class="border-b border-stone-100 hover:bg-stone-50 transition-colors">
                    <td class="py-3 pr-4">
                      <span class="font-medium text-stone-800">{route.destination[lang]}</span>
                      <span class="text-stone-400 text-xs ml-1">{route.duration[lang]}</span>
                    </td>
                    <td class="py-3 pr-4 text-stone-600 text-xs font-mono">{route.schedules}</td>
                    <td class="py-3 text-right text-teal-700 font-semibold whitespace-nowrap">{route.fare}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Mobile cards -->
          <div class="md:hidden space-y-3">
            {aguila.routes.map((route) => (
              <div class="bg-stone-50 rounded-xl p-3">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="font-semibold text-stone-800 text-sm">{route.destination[lang]}</span>
                  <span class="text-teal-700 font-bold text-sm">{route.fare}</span>
                </div>
                <p class="text-xs text-stone-400 mb-1.5">{route.duration[lang]}</p>
                <p class="text-xs text-stone-600 font-mono leading-relaxed">{route.schedules}</p>
              </div>
            ))}
          </div>

          <div class="mt-4 flex flex-wrap gap-3 text-xs text-stone-500">
            <a href={`tel:${aguila.phoneTollFree.replace(/\s/g, '')}`} class="inline-flex items-center gap-1.5 hover:text-teal-700 transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              {aguila.phoneTollFree}
            </a>
            <a href={aguila.website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-teal-700 transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              autobusesaguila.com
            </a>
          </div>
        </div>
      </details>

      <!-- Tiburón Urbano -->
      <details class="transport-accordion group bg-white rounded-2xl shadow-lg border border-stone-200 overflow-hidden">
        <summary class="cursor-pointer select-none list-none">
          <div class="bg-stone-800 px-5 py-4 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <div class="shrink-0 w-10 h-10 bg-stone-700 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
              </div>
              <div class="min-w-0">
                <h3 class="text-lg font-bold text-white font-handwritten leading-tight">{tiburonUrbano.name}</h3>
                <p class="text-stone-400 text-xs mt-0.5">{t('transport.urban')} · {tiburonUrbano.hours} · {t('transport.every_min')}</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-stone-400 transition-transform duration-300 group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </div>
        </summary>
        <div class="p-5 space-y-4">
          {tiburonUrbano.routes.map((route) => (
            <div class="bg-stone-50 rounded-xl p-3">
              <span class="text-sm font-bold text-teal-700">{route.name}</span>
              <p class="text-sm text-stone-600 mt-0.5">{route.description[lang]}</p>
            </div>
          ))}
          <div class="border-t border-stone-100 pt-4 space-y-2">
            <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-600">
              <span><span class="font-semibold text-stone-700">{t('transport.fare')}:</span> {tiburonUrbano.fares.general.trip} (general)</span>
              <span>{tiburonUrbano.fares.student.trip} ({lang === 'es' ? 'estudiante' : 'student'})</span>
              <span>{tiburonUrbano.fares.preferential.trip} ({lang === 'es' ? 'preferencial' : 'preferential'})</span>
            </div>
            <p class="text-xs text-stone-500">{t('transport.payment')}</p>
            <p class="text-xs text-teal-600 font-medium">{t('transport.app_tracking')}</p>
          </div>
        </div>
      </details>

      <!-- Bus La Ventana -->
      <details class="transport-accordion group bg-white rounded-2xl shadow-lg border border-stone-200 overflow-hidden">
        <summary class="cursor-pointer select-none list-none">
          <div class="bg-amber-700 px-5 py-4 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <div class="shrink-0 w-10 h-10 bg-amber-600 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div class="min-w-0">
                <h3 class="text-lg font-bold text-white font-handwritten leading-tight">{typeof ventanaBus.name === 'string' ? ventanaBus.name : ventanaBus.name[lang]}</h3>
                <p class="text-amber-200 text-xs mt-0.5">{t('transport.local')} · {ventanaBus.fare}</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-amber-200 transition-transform duration-300 group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </div>
        </summary>
        <div class="p-5 space-y-4">
          <!-- Weekdays -->
          <div>
            <p class="text-xs font-semibold text-stone-700 uppercase tracking-wider mb-2">{t('transport.weekdays')}</p>
            <div class="grid grid-cols-2 gap-2">
              <div class="bg-stone-50 rounded-xl p-3">
                <p class="text-xs text-stone-400 mb-1">{t('transport.from')} Sargento</p>
                <p class="font-mono font-medium text-stone-800 text-sm">{ventanaBus.weekday.fromSargento.join(', ')}</p>
              </div>
              <div class="bg-stone-50 rounded-xl p-3">
                <p class="text-xs text-stone-400 mb-1">{t('transport.from')} La Paz</p>
                <p class="font-mono font-medium text-stone-800 text-sm">{ventanaBus.weekday.fromLaPaz.join(', ')}</p>
              </div>
            </div>
          </div>
          <!-- Sundays -->
          <div>
            <p class="text-xs font-semibold text-stone-700 uppercase tracking-wider mb-2">{t('transport.sundays')}</p>
            <div class="grid grid-cols-2 gap-2">
              <div class="bg-stone-50 rounded-xl p-3">
                <p class="text-xs text-stone-400 mb-1">{t('transport.from')} Sargento</p>
                <p class="font-mono font-medium text-stone-800 text-sm">{ventanaBus.sunday.fromSargento.join(', ')}</p>
              </div>
              <div class="bg-stone-50 rounded-xl p-3">
                <p class="text-xs text-stone-400 mb-1">{t('transport.from')} La Paz</p>
                <p class="font-mono font-medium text-stone-800 text-sm">{ventanaBus.sunday.fromLaPaz.join(', ')}</p>
              </div>
            </div>
          </div>
          <!-- Contact -->
          <div class="border-t border-stone-100 pt-3 flex flex-col sm:flex-row flex-wrap gap-2 text-xs text-stone-500">
            <a href={ventanaBus.mapLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-amber-700 transition-colors">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              {ventanaBus.pickup[lang]}
            </a>
            <a href={`tel:${ventanaBus.phone.replace(/\s/g, '')}`} class="inline-flex items-center gap-1.5 hover:text-amber-700 transition-colors">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              {ventanaBus.phone}
            </a>
          </div>
        </div>
      </details>

    </div>
  </div>
</section>

<style>
@import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&display=swap');

.font-handwritten {
  font-family: 'Caveat', cursive;
}

/* Remove default marker from summary */
details summary::-webkit-details-marker {
  display: none;
}

/* Smooth open/close animation */
.transport-accordion > div {
  animation: accordion-open 0.3s ease-out;
}

@keyframes accordion-open {
  from {
    opacity: 0;
    max-height: 0;
  }
  to {
    opacity: 1;
    max-height: 1000px;
  }
}
</style>
