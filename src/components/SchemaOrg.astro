---
import { getLangFromUrl, useTranslations, CONTACT_DATA, TOURS_DATA } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const siteUrl = Astro.site!.toString().replace(/\/$/, "");
const currentPath = Astro.url.pathname;

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
const currentUrl = new URL(currentPath, Astro.site).href;

// LodgingBusiness + RVPark schema
const businessSchema = {
	"@context": "https://schema.org",
	"@type": ["LodgingBusiness", "RVPark"],
	"@id": `${siteUrl}/#business`,
	name: "Peace Center",
	description: t("seo.description"),
	url: siteUrl,
	telephone: CONTACT_DATA.phone,
	email: CONTACT_DATA.email,
	image: `${siteUrl}/peace-center.webp`,
	logo: `${siteUrl}/peace-center-logo.jpeg`,
	priceRange: "$$",
	checkinTime: "14:00",
	checkoutTime: "12:00",
	numberOfRooms: 6,
	address: {
		"@type": "PostalAddress",
		streetAddress: "Calle Jalisco",
		addressLocality: "La Paz",
		addressRegion: "Baja California Sur",
		postalCode: "23060",
		addressCountry: "MX",
	},
	openingHoursSpecification: {
		"@type": "OpeningHoursSpecification",
		dayOfWeek: [
			"Monday",
			"Tuesday",
			"Wednesday",
			"Thursday",
			"Friday",
			"Saturday",
			"Sunday",
		],
		opens: "00:00",
		closes: "23:59",
	},
	geo: {
		"@type": "GeoCoordinates",
		latitude: 24.1426,
		longitude: -110.3128,
	},
	amenityFeature: [
		{ "@type": "LocationFeatureSpecification", name: "Full Hookups", value: true },
		{ "@type": "LocationFeatureSpecification", name: "Wi-Fi", value: true },
		{ "@type": "LocationFeatureSpecification", name: "BBQ Area", value: true },
		{ "@type": "LocationFeatureSpecification", name: "Showers", value: true },
		{ "@type": "LocationFeatureSpecification", name: "Air Conditioning", value: true },
	],
	sameAs: [CONTACT_DATA.instagram],
	potentialAction: {
		"@type": "ReserveAction",
		target: {
			"@type": "EntryPoint",
			urlTemplate: CONTACT_DATA.whatsapp,
		},
		result: {
			"@type": "LodgingReservation",
			name: lang === "es" ? "Reservar por WhatsApp" : "Book via WhatsApp",
		},
	},
};

// WebSite schema
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${siteUrl}/#website`,
	name: "Peace Center",
	url: siteUrl,
	publisher: { "@id": `${siteUrl}/#business` },
	inLanguage: [
		{ "@type": "Language", name: "Spanish", alternateName: "es" },
		{ "@type": "Language", name: "English", alternateName: "en" },
	],
};

// BreadcrumbList schema
const pathSegments = currentPath.split("/").filter(Boolean);
const breadcrumbItems = [
	{
		"@type": "ListItem",
		position: 1,
		name: lang === "es" ? "Inicio" : "Home",
		item: lang === "es" ? `${siteUrl}/` : `${siteUrl}/en/`,
	},
];

if (pathSegments.length > 0 && !(pathSegments.length === 1 && pathSegments[0] === "en")) {
	breadcrumbItems.push({
		"@type": "ListItem",
		position: 2,
		name: pathSegments[pathSegments.length - 1]
			.replace(/-/g, " ")
			.replace(/\b\w/g, (c: string) => c.toUpperCase()),
		item: `${siteUrl}${currentPath}`,
	});
}

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"@id": `${currentUrl}#breadcrumb`,
	itemListElement: breadcrumbItems,
};

const webPageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"@id": `${currentUrl}#webpage`,
	url: currentUrl,
	name: title ?? (lang === "es" ? "Peace Center" : "Peace Center"),
	description: description ?? t("seo.description"),
	inLanguage: lang,
	isPartOf: { "@id": `${siteUrl}/#website` },
	about: { "@id": `${siteUrl}/#business` },
	breadcrumb: { "@id": `${currentUrl}#breadcrumb` },
};

// TouristTrip ItemList schema
const toursData = TOURS_DATA[lang];
const toursListSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: lang === "es" ? "Tours y Experiencias" : "Tours & Experiences",
	itemListElement: toursData.map((tour: { title: string; description: string }, index: number) => ({
		"@type": "ListItem",
		position: index + 1,
		item: {
			"@type": "TouristTrip",
			name: tour.title,
			description: tour.description,
			touristType: "Adventure",
			provider: { "@id": `${siteUrl}/#business` },
		},
	})),
};
---

<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(toursListSchema)} />
